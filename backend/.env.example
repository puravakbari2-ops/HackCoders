# Server Configuration
PORT=5000
NODE_ENV=development

# CORS - allowed frontend origin
FRONTEND_URL=http://localhost:3000

# ── Gemini AI Configuration ──────────────────────────────────
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Embedding model (512-dim local feature hashing or Gemini embedding)
EMBEDDING_MODEL=gemini-embedding-001
USE_LOCAL_EMBEDDINGS=true

# LLM model for chat responses
LLM_MODEL=gemini-3.6-flash

# ── RAG Configuration ────────────────────────────────────────
# Number of candidates from initial retrieval
TOP_K_RETRIEVAL=15

# Number of final context chunks sent to LLM
TOP_K_CONTEXT=5

# Minimum similarity threshold (0-1). Below this = low confidence
SIMILARITY_THRESHOLD=0.35

# Enable RAG debug mode (shows retrieval diagnostics in API response)
RAG_DEBUG=false

# ── Knowledge Base ───────────────────────────────────────────
# Version tracking
KB_VERSION=1.0.0

# ── Google Cloud Text-to-Speech ──────────────────────────────
# Set to true to enable official Google Cloud TTS
GOOGLE_TTS_ENABLED=true

# Authentication Method 1: Path to downloaded Service Account JSON file
# e.g., C:\keys\jansahay-service-account.json
# NEVER commit the actual JSON key file!
GOOGLE_APPLICATION_CREDENTIALS=

# Multilingual Indian Google Cloud Voice Mappings
GOOGLE_TTS_EN_VOICE=en-IN-Neural2-A
GOOGLE_TTS_HI_VOICE=hi-IN-Neural2-A
GOOGLE_TTS_GU_VOICE=gu-IN-Wavenet-A

# Voice Audio Configuration
GOOGLE_TTS_SPEAKING_RATE=0.95
GOOGLE_TTS_PITCH=0

# ── Supabase Configuration ────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
